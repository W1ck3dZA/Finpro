generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  STAFF
}

enum ImportType {
  CLIENT
  JOB
  TIME
}

enum ImportStatus {
  SUCCESS
  PARTIAL
  FAILED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(255)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  role         Role     @default(STAFF)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  importBatches  ImportBatch[]
  staffMembers   StaffMember[]

  @@index([role])
}

model Client {
  id                  Int       @id @default(autoincrement())
  name                String    @unique @db.VarChar(255)
  businessStructure   String?   @db.VarChar(100)
  provisionalTaxpayer Boolean?
  firstName           String?   @db.VarChar(150)
  lastName            String?   @db.VarChar(150)
  companyNumber       String?   @db.VarChar(100)
  cipcDate            DateTime? @db.Date
  taxNumber           String?   @db.VarChar(100)
  email               String?   @db.VarChar(255)
  phone               String?   @db.VarChar(50)
  country             String?   @db.VarChar(100)
  address             String?   @db.Text
  payrollClient       Boolean?
  cashbook            Boolean?
  vatSubmission       Boolean?
  jobManager          String?   @db.VarChar(150)
  clientType          String?   @db.VarChar(50)
  isStub              Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  jobs       Job[]
  timesheets Timesheet[]

  @@index([jobManager])
  @@index([businessStructure])
  @@index([clientType])
  @@index([isStub])
}

model Job {
  id                Int       @id @default(autoincrement())
  jobNo             String    @unique @db.VarChar(50)
  clientId          Int
  client            Client    @relation(fields: [clientId], references: [id])
  name              String?   @db.VarChar(500)
  startDate         DateTime? @db.Date
  budget            Decimal?  @db.Decimal(12, 2)
  state             String    @db.VarChar(100)
  completedDate     DateTime? @db.Date
  actualTimeMinutes Int?
  isStub            Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  timesheets Timesheet[]

  @@index([clientId])
  @@index([state])
  @@index([startDate])
  @@index([completedDate])
  @@index([isStub])
}

model StaffMember {
  id              Int      @id @default(autoincrement())
  name            String   @unique @db.VarChar(150)
  hourlyRate      Decimal? @db.Decimal(10, 2)
  monthlyCtc      Decimal? @db.Decimal(10, 2)
  monthlyExpenses Decimal? @db.Decimal(10, 2)
  linkedUserId    Int?
  linkedUser      User?    @relation(fields: [linkedUserId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  timesheets Timesheet[]

  @@index([linkedUserId])
}

model Timesheet {
  id            Int      @id @default(autoincrement())
  clientId      Int
  client        Client   @relation(fields: [clientId], references: [id])
  jobId         Int
  job           Job      @relation(fields: [jobId], references: [id])
  staffMemberId Int
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id])
  entryDate     DateTime @db.Date
  minutes       Int
  note          String?  @db.Text
  importBatchId Int
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id])
  createdAt     DateTime @default(now())

  @@index([clientId])
  @@index([jobId])
  @@index([staffMemberId])
  @@index([entryDate])
  @@index([importBatchId])
}

model ImportBatch {
  id           Int          @id @default(autoincrement())
  type         ImportType
  filename     String       @db.VarChar(500)
  uploadedById Int
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])
  rowsTotal    Int
  rowsInserted Int
  rowsUpdated  Int
  rowsSkipped  Int
  status       ImportStatus
  summary      Json
  warnings     Json
  createdAt    DateTime     @default(now())

  timesheets Timesheet[]

  @@index([type])
  @@index([createdAt])
}
