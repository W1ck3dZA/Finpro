# --- MySQL bootstrap (used by scripts/init-db.sh to create the app database/user) ---
# DB_ROOT_USER/DB_ROOT_PASSWORD must be a local MySQL/MariaDB account that can create
# databases and users (e.g. the real 'root' account and its password).
DB_ROOT_USER=root
DB_ROOT_PASSWORD=changeme
DB_NAME=finpro
DB_APP_USER=finpro_app
DB_APP_PASSWORD=changeme

# --- Used by Prisma / the app at runtime ---
DATABASE_URL="mysql://finpro_app:changeme@localhost:3306/finpro?charset=utf8mb4"
SHADOW_DATABASE_URL="mysql://finpro_app:changeme@localhost:3306/finpro_shadow?charset=utf8mb4"

JWT_SECRET=changeme
PORT=4000

# Bootstrap admin, created once by `npx prisma db seed` (no-op if a user already exists)
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL=admin@finpro.co.za
SEED_ADMIN_PASSWORD=changeme
